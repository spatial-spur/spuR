TARGET_DIR = rust/target
ifndef WIN_TARGET
  R_NATIVE_ARCH := $(shell "$(R_HOME)/bin/Rscript.exe" --vanilla -e "cat(R.version[['arch']])")
  WIN_TARGET := $(if $(filter aarch64 arm64,$(R_NATIVE_ARCH)),aarch64-pc-windows-gnullvm,x86_64-pc-windows-gnu)
endif
LIBDIR = $(TARGET_DIR)/$(WIN_TARGET)/release
STATLIB = $(LIBDIR)/libspur_rust.a

SPATIAL_RUST ?= 1
CARGO ?= cargo
VENDOR_ARCHIVE = $(wildcard rust/vendor.tar.xz)
VENDOR_DIR = $(wildcard rust/vendor)
VENDOR_CONFIG = $(wildcard rust/vendor-config.toml)
CARGO_VENDOR_FLAGS = $(if $(VENDOR_ARCHIVE)$(VENDOR_DIR),--offline $(if $(VENDOR_CONFIG),--config target/vendor-config.toml),)

ifeq ($(strip $(SPATIAL_RUST)),0)
  RUST_AVAILABLE :=
else
  RUST_TARGET_LIBDIR := $(shell rustc --print target-libdir --target "$(WIN_TARGET)" 2>/dev/null)
  RUST_AVAILABLE := $(shell test -n "$(RUST_TARGET_LIBDIR)" && test -d "$(RUST_TARGET_LIBDIR)" && command -v "$(CARGO)" 2>/dev/null)
endif

RUST_SYS_LIBS = -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lm

ifneq ($(strip $(RUST_AVAILABLE)),)
  RUST_MODE = rust
  PKG_CFLAGS = -DSPATIAL_USE_RUST
  PKG_LIBS = $(STATLIB) $(RUST_SYS_LIBS)
  RUST_DEPS = $(STATLIB)
else
  RUST_MODE = norust
  PKG_CFLAGS =
  PKG_LIBS =
  RUST_DEPS =
endif

PREV_MODE := $(shell cat .spatial_rust_mode 2>/dev/null || true)
ifneq ($(PREV_MODE),$(RUST_MODE))
  $(shell rm -f init.o $(SHLIB) && printf '%s\n' "$(RUST_MODE)" > .spatial_rust_mode)
endif

all: $(SHLIB)

$(SHLIB): $(RUST_DEPS)

.PHONY: $(STATLIB)
$(STATLIB):
	"$(CARGO)" --version && rustc --version
	$(if $(VENDOR_ARCHIVE),tar -xf "$(VENDOR_ARCHIVE)" -C rust,:)
	$(if $(VENDOR_CONFIG),mkdir -p "$(TARGET_DIR)" && cp "$(VENDOR_CONFIG)" "$(TARGET_DIR)/vendor-config.toml",:)
	cd rust && CARGO_TARGET_DIR="$(CURDIR)/$(TARGET_DIR)" "$(CARGO)" build --release --target $(WIN_TARGET) $(CARGO_VENDOR_FLAGS) --locked
