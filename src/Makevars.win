TARGET_DIR = rust/target
ifndef WIN_TARGET
  R_NATIVE_ARCH := $(shell "$(R_HOME)/bin/Rscript.exe" --vanilla -e "cat(R.version[['arch']])")
  WIN_TARGET := $(if $(filter aarch64 arm64,$(R_NATIVE_ARCH)),aarch64-pc-windows-gnullvm,x86_64-pc-windows-gnu)
endif
LIBDIR = $(TARGET_DIR)/$(WIN_TARGET)/release
STATLIB = $(LIBDIR)/libspur_rust.a

SPATIAL_RUST ?= 1
CARGO ?= cargo
VENDOR_ARCHIVE = $(wildcard rust/vendor.tar.xz)
VENDOR_DIR = $(wildcard rust/vendor)
VENDOR_CONFIG = $(wildcard rust/vendor-config.toml)
CARGO_VENDOR_ENV = $(if $(VENDOR_ARCHIVE)$(VENDOR_DIR),CARGO_HOME="$(CURDIR)/$(TARGET_DIR)/cargo-home")
CARGO_VENDOR_FLAGS = $(if $(VENDOR_ARCHIVE)$(VENDOR_DIR),--offline $(if $(VENDOR_CONFIG),--config target/vendor-config.toml),)

ifeq ($(strip $(SPATIAL_RUST)),0)
  RUST_AVAILABLE :=
else
  RUST_TARGET_LIBDIR := $(shell rustc --print target-libdir --target "$(WIN_TARGET)" 2>/dev/null)
  RUSTC_SUPPORTED := $(shell rustc --version 2>/dev/null | awk '/^rustc / { split($$2,v,"."); if (v[1] >= 2 || (v[1] == 1 && v[2] >= 85)) print "yes" }')
  RUST_AVAILABLE := $(if $(RUSTC_SUPPORTED),$(shell test -n "$(RUST_TARGET_LIBDIR)" && test -d "$(RUST_TARGET_LIBDIR)" && command -v "$(CARGO)" 2>/dev/null))
  ifeq ($(strip $(RUST_AVAILABLE)),)
    $(info Using the R fallback. Native builds require Cargo and rustc >= 1.85 with the R target installed.)
  endif
endif

RUST_SYS_LIBS = -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lm

ifneq ($(strip $(RUST_AVAILABLE)),)
  RUST_MODE = rust
  PKG_CFLAGS = -DSPATIAL_USE_RUST
  PKG_LIBS = $(STATLIB) $(RUST_SYS_LIBS)
  RUST_DEPS = $(STATLIB)
else
  RUST_MODE = norust
  PKG_CFLAGS =
  PKG_LIBS =
  RUST_DEPS =
endif

all: $(SHLIB)

init.o: .spatial_rust_mode

.PHONY: force-rust-mode
.spatial_rust_mode: force-rust-mode
	@if [ "$$(cat $@ 2>/dev/null)" != "$(RUST_MODE)" ]; then printf '%s\n' "$(RUST_MODE)" > "$@"; fi

# R links this explicit export list through its winshlib.mk rule.
$(SHLIB): $(RUST_DEPS) spuR-win.def

.PHONY: $(STATLIB)
$(STATLIB):
	"$(CARGO)" --version && rustc --version
	$(if $(VENDOR_ARCHIVE),tar -xf "$(VENDOR_ARCHIVE)" -C rust,:)
	$(if $(VENDOR_CONFIG),mkdir -p "$(TARGET_DIR)" && cp "$(VENDOR_CONFIG)" "$(TARGET_DIR)/vendor-config.toml",:)
	cd rust && $(CARGO_VENDOR_ENV) CARGO_TARGET_DIR="$(CURDIR)/$(TARGET_DIR)" "$(CARGO)" build -j 2 --release --target $(WIN_TARGET) $(CARGO_VENDOR_FLAGS) --locked
